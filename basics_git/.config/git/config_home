[user]
	name = Sebastian Stigler
	email = s_stigler@gmx.de
[core]
	editor = nvim
	pager = bat --style=plain
	autocrlf = input
	symlink = true
[commit]
	template = ~/.config/git/message
[color]
	ui = true
	branch = auto
	diff = auto
	status = auto
	interactiv = auto
[alias]
	l = log --pretty=format:'%C(bold cyan)%h%Creset %s %C(bold blue)%d%Creset' --graph --branches
	la = log --pretty=format:'%C(bold cyan)%h%Creset %s %C(bold blue)%d%Creset %Cred%an%Creset %Cgreen%cD%Creset ' --graph --all
	laa = log --pretty=format:'%C(bold cyan)commit %H%C(bold blue)%d%Creset%n%CredAuthor: %an <%ae>%Creset%n%CgreenDate:   %cD%Creset%n%+s%w(76,6,9)%n%+b%w(76,6,9)%nNotes:%+N%w(76,6,9)' --graph --all
	co = checkout
	bc = branch-check
[push]
	default = matching
[init]
	defaultBranch = master
[merge]
	tool = nvimdiff2
[color "blame"]
	highlightRecent = 234, 23 month ago, 235, 22 month ago, 236, 21 month ago, 237, 20 month ago, 238, 19 month ago, 239, 18 month ago, 240, 17 month ago, 241, 16 month ago, 242, 15 month ago, 243, 14 month ago, 244, 13 month ago, 245, 12 month ago, 246, 11 month ago, 247, 10 month ago, 248, 9 month ago, 249, 8 month ago, 250, 7 month ago, 251, 6 month ago, 252, 5 month ago, 253, 4 month ago, 254, 3 month ago, 231, 2 month ago, 230, 1 month ago, 229, 3 weeks ago, 228, 2 weeks ago, 227, 1 week ago, 226
[blame]
	coloring = highlightRecent
	date = human
