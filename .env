# Recipe

## normal COLor
UI_RCOL='\e[0;34;1m'
## SYMbol
UI_RSYM='🎁  '${UI_RCOL}
## HIghlight Color
UI_RHIC='\e[0;36m'

# Subrecipe

UI_SCOL='\e[0;34m'
UI_SSYM='    \e[33;1m• '${UI_SCOL}
UI_SHIC='\e[0;36m'
## WArning Color
UI_SWAC='\e[0;31;1m'
## emphazise color
UI_SEMC='\e[0;31;3m'
## ERrorline Start
UI_SERS='    ⚡ '${UI_SWAC}
## ERrorline End
UI_SERE='\e[0m ⚡'

# Afteraction

UI_ACOL='\e[0;33;1m'
UI_ASYM='      \e[31;1m╰─❯ '${UI_ACOL}
UI_AHIC='\e[0;36;3m'
# INDentation for multiline answers
UI_AIND='            '
# subrecipePart (Use for longrunning parts of a subrecipe)

UI_PCOL='\e[0;35m'
UI_PSYM='      • '${UI_PCOL}
UI_PHIC='\e[0;35;1m'
UI_PWAC='\e[0;95m'

# Reset to Normal

UI_NORMAL='\e[0m'

# Short phrases

UI_FINISHED='\n    ✨✨  \e[32;1mFinished\e[0m  ✨✨\n'
UI_SKIPPED="${UI_SCOL} [${UI_SWAC}skipped${UI_SCOL}]${UI_NORMAL}"
UI_SEP="${UI_NORMAL}|${UI_SCOL}"
